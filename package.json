{
  "name": "danmaku-overlay",
  "version": "1.2.0",
  "description": "一站式弹幕观影工具：内置浏览器在线观影 / 本地视频播放，弹幕自动叠加并跟随视频同步；内置腾讯视频弹幕在线采集；兼容原透明置顶外挂悬浮窗模式",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win portable",
    "dist": "electron-builder --win nsis",
    "pack:dir": "electron-builder --dir"
  },
  "build": {
    "appId": "com.danmaku.overlay",
    "productName": "DanmakuOverlay",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "data/**/*",
      "!data/s5_mzc002005od4txd/raw/**",
      "!data/s6_*",
      "!data/s5_mzc00200c24ypkp/**"
    ],
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "DanmakuOverlay-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "DanmakuOverlay-${version}-setup.${ext}"
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  },
  "keywords": [
    "danmaku",
    "electron",
    "overlay",
    "视频",
    "弹幕",
    "弹幕发射器"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "playwright-core": "^1.62.1"
  }
}
